# SQLite en desarrollo. En producción: postgresql://usuario:pass@host:5432/toma_muestras
DATABASE_URL="file:./dev.db"
# Mínimo 32 caracteres aleatorios
SESSION_SECRET=""
# Zona horaria para calcular "hoy"
APP_TZ="Europe/Madrid"

# Lectura de PDFs de resultados con IA (Google Gemini). Sin clave, los PDFs se guardan y quedan pendientes de leer.
GEMINI_API_KEY=""
# Opcional: modelo de Gemini (por defecto gemini-2.5-flash)
GEMINI_MODEL=""
# Opcional: carpeta donde se guardan los PDFs (por defecto ./storage)
STORAGE_DIR=""
